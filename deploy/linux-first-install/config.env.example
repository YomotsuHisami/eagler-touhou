# Required public/origin identity.
SITE_HOST=touhou.example.com
ORIGIN_LISTEN=80
# Optional explicit loopback URL used by verify-host.sh. This is useful when
# ORIGIN_LISTEN includes an address or when a container publishes another port.
ORIGIN_TEST_URL=http://127.0.0.1:80
SITE_ROOT=/srv/eagler-touhou
SITE_CONFIG_NAME=eagler-touhou
# Unique short identifier for this Nginx map variable (1-12 characters).
MIGRATION_MAP_ID=eagler

# The CDN normally terminates HTTPS. Keep redirects relative at the origin.
CDN_TERMINATES_TLS=1
# CDN must forward X-Forwarded-Proto. HTTPS requests should arrive as
# X-Forwarded-Proto: https; direct/legacy HTTP has no header or says http.

# local: install and run the bundled lan-relay.cjs on loopback.
# external: proxy /eagler-netplay/ to RELAY_UPSTREAM. http(s):// and ws(s)://
# are both accepted; ws(s):// is normalized internally for Nginx proxy_pass.
# disabled: return 404 for the multiplayer endpoint.
RELAY_MODE=local
RELAY_UPSTREAM=http://127.0.0.1:18142
RELAY_LISTEN_HOST=127.0.0.1
RELAY_LISTEN_PORT=18142
# The supplied bundle currently carries the official Linux x64 Node runtime.
NODE_RUNTIME_ARCH=x64

# local: install/configure coturn and issue short-lived REST credentials.
# external: the relay advertises the supplied external TURN URLs/credentials.
# disabled: STUN/direct RTC plus WebSocket fallback only.
TURN_MODE=local
STUN_URLS=stun:stun.cloudflare.com:3478
TURN_URLS=turn:touhou.example.com:3478?transport=udp,turn:touhou.example.com:3478?transport=tcp
TURN_REALM=eagler-touhou
TURN_LISTENING_PORT=3478
TURN_LISTENING_IP=
TURN_RELAY_IP=
# For a NAT host use PUBLIC_IP/PRIVATE_IP, for example 203.0.113.7/10.0.0.7.
TURN_EXTERNAL_IP=203.0.113.7
TURN_MIN_PORT=49160
TURN_MAX_PORT=49559

# Optional static credentials for an external TURN service. Prefer a shared
# REST secret. Leave all three empty when TURN_MODE=local: bootstrap generates
# a server-only secret and gives coturn and the relay the same value.
TURN_SHARED_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=

# Host lifecycle.
KEEP_RELEASES=3
INSTALL_OS_PACKAGES=1
DISABLE_DEFAULT_NGINX_SITE=0

# Cloud/provider firewall contract for local TURN:
# TCP 80 (or ORIGIN_LISTEN) from CDN egress only; TCP+UDP 3478 and
# UDP TURN_MIN_PORT-TURN_MAX_PORT from players. Never expose RELAY_LISTEN_PORT.
